{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run LivingRoom Scene",
      "type": "shell",
      "command": "${input:godotExecutable}",
      "args": [
        "--path",
        "${workspaceFolder}",
        "--scene",
        "res://scenes/rooms/LivingRoom.tscn"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run LivingRoom 3D Scene",
      "type": "shell",
      "command": "${input:godotExecutable}",
      "args": [
        "--path",
        "${workspaceFolder}",
        "--scene",
        "res://scenes/rooms/LivingRoom3D.tscn"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "godotExecutable",
      "type": "promptString",
      "description": "Absolute path to Godot executable",
      "default": "/Applications/Godot.app/Contents/MacOS/Godot"
    }
  ]
}
